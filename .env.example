# Spotify API Credentials (Optional - enhanced metadata & large playlists)
# Get yours from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# Downloader Defaults
DJ_DL_OUTPUT_DIR=~/Music/DJ_Downloads
DJ_DL_AUDIO_FORMAT=mp3
DJ_DL_AUDIO_BITRATE=320k
DJ_DL_MIN_DELAY_SECONDS=2.0
DJ_DL_MAX_DELAY_SECONDS=5.0
DJ_DL_RECURSIVE_SCAN=true
